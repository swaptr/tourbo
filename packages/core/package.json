{
  "name": "@tourbo/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "plan:demo": "node --env-file-if-exists=../../.env src/engine/demo.ts",
    "typecheck": "tsc -p tsconfig.json",
    "cities:seed": "node --env-file-if-exists=../../.env scripts/seed-cities.ts",
    "db:import": "node --env-file-if-exists=../../.env scripts/db-import.ts",
    "kinds:set": "node --env-file-if-exists=../../.env scripts/kinds-set.ts",
    "kinds:list": "node --env-file-if-exists=../../.env scripts/kinds-set.ts --list"
  },
  "dependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "p-limit": "7.3.3",
    "postgres": "^3.4.9",
    "zod": "4.6.7"
  }
}
