{
  "name": "tourbo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tourbo/web",
    "build": "npm run build -w @tourbo/web",
    "start": "npm run start -w @tourbo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "qloo:ping": "npm run qloo:ping -w @tourbo/web",
    "qloo:probe": "npm run qloo:probe -w @tourbo/web",
    "qloo:prewarm": "npm run qloo:prewarm -w @tourbo/web",
    "plan:demo": "npm run plan:demo -w @tourbo/core --",
    "agent:demo": "npm run agent:demo -w @tourbo/web --",
    "mcp": "npm run start -w @tourbo/mcp",
    "test:stories": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/stories/*.test.ts",
    "perf:home": "node tests/perf/home.ts",
    "landing:load": "npm run landing:load -w @tourbo/web --",
    "backtest": "npm run backtest -w @tourbo/web",
    "cities:seed": "npm run cities:seed -w @tourbo/core --",
    "db:import": "npm run db:import -w @tourbo/core --",
    "examples:prewarm": "npm run examples:prewarm -w @tourbo/web --",
    "examples:export": "npm run examples:export -w @tourbo/web --"
  },
  "devDependencies": {
    "@types/node": "^22",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@17.10.0-beta.17": true
  }
}
