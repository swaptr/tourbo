# Copy to .env (git-ignored). Never commit real keys.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
ANTHROPIC_API_KEY=
# Outreach via Resend (optional; sends are simulated without a key)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
OUTREACH_FROM=Tourbo <onboarding@resend.dev>
OUTREACH_INBOX=delivered@resend.dev
OUTREACH_REPLY_DOMAIN=
# Remote MCP endpoint /mcp (optional): comma-separated bearer tokens
MCP_TOKENS=
# Disciplines the website offers: "all" (default) or comma-separated keys, e.g. musician,comedian (MCP accepts every one)
DEMO_DISCIPLINES=all
PUBLIC_URL=
# Postgres (optional). Unset = local embedded Postgres in .data/postgres.
# Old Docker one: postgres://tourbo:tourbo@localhost:5433/tourbo
DATABASE_URL=
# Cache tiers, read in order, written through: memory,file,postgres or "none".
# Default: none in production (live app + MCP always fresh; only the landing page is pre-baked),
# memory,postgres in dev
CACHE_TIERS=
# File tier directory (default: system temp dir); read-only in production unless "false"
CACHE_DIR=
CACHE_FILE_READONLY=
